{
  "schema_version": "1.0.0",
  "title": "Income profile parameters by profession",
  "description": "Taxonomy of professions mapped to four lognormal income profiles. Parameters are inherited from income_profiles unless overridden downstream by country, currency, seniority or employment-status adjustments.",
  "distribution": {
    "name": "lognormal",
    "formula": "income ~ LogNormal(mu, sigma)",
    "parameter_scale": "natural logarithm",
    "unit": "same monetary unit and period as the original model",
    "warning": "These are modelling priors, not official salary estimates. Employment status and actual cash-flow behaviour take precedence over profession title."
  },
  "income_profiles": {
    "bank_stable": {
      "mu": 12.15,
      "sigma": 0.28,
      "definition": "Regular and predictable salary, pension or institutional payroll, generally paid through a bank or mobile-money account."
    },
    "sme_formal": {
      "mu": 12.05,
      "sigma": 0.40,
      "definition": "Formal SME owner, registered independent professional or salaried employee of a structured private business, with moderately variable income."
    },
    "micro_informal": {
      "mu": 11.65,
      "sigma": 0.55,
      "definition": "Informal micro-entrepreneur, casual worker, commission worker or self-employed service provider with irregular cash income."
    },
    "agri_seasonal": {
      "mu": 11.50,
      "sigma": 0.70,
      "definition": "Agriculture, livestock, fishing or forestry activity whose income is strongly seasonal and exposed to weather, biological and commodity-price risks."
    }
  },
  "classification_priority": [
    "explicit_income_pattern",
    "employment_status",
    "employer_type",
    "profession",
    "sector_default"
  ],
