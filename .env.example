# Copier ce fichier en ".env" et renseigner les vraies valeurs.
# Le ".env" reel n'est JAMAIS committe (cf .gitignore).

# --- Application ----------------------------------------------------------
DEBUG=false

# --- MongoDB (persistance proprietaire du Loader) -------------------------
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=loader_finzuu

# --- Bootstrap Super-Admin (Phase 1 = Super-Admin uniquement) -------------
# Le compte est cree au premier demarrage s'il est absent en base, avec
# must_change_password=true. Le mot de passe initial n'est jamais durable.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD_INITIAL=

# --- Fenetre de simulation (ENF-16 : 180 jours parametrable) --------------
# Laisser COMMENTE pour utiliser la fenetre par defaut (180 jours).
# Une valeur VIDE casse le demarrage : pydantic attend une date, pas ''.
#SIM_START_DATE=
#SIM_END_DATE=

# --- Faker fintech4esg ----------------------------------------------------
FAKER_BASE_URL=https://faker.fintech4esg.com
FAKER_API_KEY=

# --- Credentials ROOT FinZuu ----------------------------------------------
# D-DEP-7 (FRA-205) : depositary-service n'applique aucune RBAC reelle.
# Toute ecriture sur ce service utilise exclusivement ce compte ROOT.
ROOT_USERNAME=
ROOT_PASSWORD=

# --- Bases des 9 microservices ---------------------------------------------
# Valeurs par defaut = environnement TEST exclusivement (ENF-16 / R-06).
# Ne JAMAIS pointer ces variables vers un environnement de production.
# USER_SERVICE_BASE=https://user-service.test.services.fintech4esg.com
# CONFIG_SERVICE_BASE=https://config-service.test.services.fintech4esg.com
# IDENTITY_SERVICE_BASE=https://identity-service.test.services.fintech4esg.com
# ACCOUNT_SERVICE_BASE=https://account-service.test.services.fintech4esg.com
# COMPANY_SERVICE_BASE=https://company-service.test.services.fintech4esg.com
# PRODUCT_SERVICE_BASE=https://product-service.test.services.fintech4esg.com
# DEPOSITARY_SERVICE_BASE=https://depositary-service.test.services.fintech4esg.com
# CLIENT_SERVICE_BASE=https://client-service.test.services.fintech4esg.com
# COLLECT_SERVICE_BASE=https://collect-service.test.services.fintech4esg.com

# --- CORS — origine du frontend de Zidane (le Loader = backend web app) -----
# Si le frontend est sur un AUTRE domaine que cette API, le navigateur exige
# CORS. Origines EXACTES separees par des virgules (jamais '*'). Vide = aucune.
# Exemple prod : CORS_ALLOW_ORIGINS=https://simul.fintech4esg.com
CORS_ALLOW_ORIGINS=
